# This value is embedded into the browser bundle during `npm run build`.
# Use your public API origin, or /api if Nginx proxies /api to the backend.
VITE_API_BASE_URL=https://api.example.com

# Server-only Google Places API (New) key. Never prefix this with VITE_.
GOOGLE_MAPS_API_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
